{
  "family": "storymem",
  "planner": "public_qwen",
  "upstream": "${MSPC_SHARED_ROOT}/comparison_methods/StoryMem",
  "weights": {
    "t2v": "${MSPC_SHARED_ROOT}/OoVMetric/models_ckpt/wan22_t2v_a14b",
    "m2v": "${MSPC_SHARED_ROOT}/OoVMetric/models_ckpt/wan22_i2v_a14b",
    "tokenizer": "${MSPC_SHARED_ROOT}/OoVMetric/models_ckpt/wan22_t2v_a14b/google/umt5-xxl",
    "low_noise_lora": "${MSPC_SHARED_ROOT}/OoVMetric/models_ckpt/storymem/StoryMem/Wan2.2-MI2V-A14B/backbone_low_noise.safetensors",
    "high_noise_lora": "${MSPC_SHARED_ROOT}/OoVMetric/models_ckpt/storymem/StoryMem/Wan2.2-MI2V-A14B/backbone_high_noise.safetensors",
    "clip": "${MSPC_SHARED_ROOT}/OoVMetric/models_ckpt/storymem/CLIP/ViT-B-32.pt",
    "hps": "${MSPC_SHARED_ROOT}/OoVMetric/models_ckpt/storymem/HPSv3/HPSv3.safetensors",
    "hps_config": "${MSPC_SHARED_ROOT}/OoVMetric/models_ckpt/storymem/HPSv3/HPSv3_7B.local.yaml"
  },
  "lora_rank": 128,
  "runtime": {
    "devices": 1,
    "t5_cpu": true,
    "convert_model_dtype": true,
    "offload_model": true
  },
  "memory": {
    "max_frames": 10,
    "fixed_first_frames": 3
  },
  "sampling": {
    "height": 480,
    "width": 832,
    "num_inference_steps": 40,
    "cfg_scale": 3.5,
    "t2v_shift": 12.0,
    "m2v_shift": 4.0,
    "solver": "unipc",
    "negative_prompt": "色调艳丽，过曝，静态，细节模糊不清，字幕，风格，作品，画作，画面，静止，整体发灰，最差质量，低质量，JPEG压缩残留，丑陋的，残缺的，多余的手指，画得不好的手部，画得不好的脸部，畸形的，毁容的，形态畸形的肢体，手指融合，静止不动的画面，杂乱的背景，三条腿，背景人很多，倒着走"
  },
  "limits": {
    "max_shots": 1,
    "max_frames": 225,
    "max_tokens": 512
  },
  "seed_stride": 1,
  "ffmpeg": "ffmpeg",
  "ffprobe": "ffprobe"
}
