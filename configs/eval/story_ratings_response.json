{
  "type": "json_schema",
  "json_schema": {
    "name": "video_ratings",
    "strict": true,
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ratings"
      ],
      "properties": {
        "ratings": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "question_number",
              "status",
              "score",
              "reason",
              "timestamps_seconds"
            ],
            "properties": {
              "question_number": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "reason": {
                "type": "string"
              },
              "timestamps_seconds": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "score": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 4
              },
              "status": {
                "type": "string",
                "enum": [
                  "rated",
                  "not_applicable"
                ]
              }
            }
          }
        }
      }
    }
  }
}
