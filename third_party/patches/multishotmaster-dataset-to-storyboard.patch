+class MultishotCsvDataset(torch.utils.data.Dataset):
+    def __init__(
+        self,
+        *,
+        metadata_path: str,
+        repeat: int,
+        height: int,
+        width: int,
+        frame_policy: str,
+        max_rgb_frames: int,
+        target_fps: float,
+        vae_temporal_stride: int,
+        metadata_filter: dict[str, Any],
+        schema: str,
+        prompt_format: str,
+        video_column: str,
+        caption_column: str,
+        shot_groups_column: str,
+        case_id_column: str | None,
+        case_id_prefix: str,
+        dataset_use_label: str,
+        allowed_use_column: str | None,
+        required_allowed_use: str | None,
+    ):
+        if type(repeat) is not int or repeat <= 0:
+            raise ValueError("repeat must be a positive int")
+        if type(height) is not int or height <= 0:
+            raise ValueError("height must be a positive int")
+        if type(width) is not int or width <= 0:
+            raise ValueError("width must be a positive int")
+        if frame_policy != FRAME_POLICY_FPS_AWARE_TARGET_FPS:
+            raise ValueError(
+                f"unsupported frame_policy={frame_policy}; expected {FRAME_POLICY_FPS_AWARE_TARGET_FPS}"
+            )
+        if schema != MULTISHOT_CSV_SCHEMA:
+            raise ValueError(f"unsupported dataset schema={schema}; expected {MULTISHOT_CSV_SCHEMA}")
+        validate_prompt_format(prompt_format)
+        self.metadata_path = require_non_empty_string(metadata_path, "metadata_path")
+        if self.metadata_path != self.metadata_path.strip():
+            raise ValueError("metadata_path must not contain surrounding whitespace")
+        self.repeat = repeat
+        self.height = height
+        self.width = width
+        self.frame_policy = frame_policy
+        self.schema = schema
+        self.prompt_format = prompt_format
+        self.video_column = require_non_empty_string(video_column, "video_column")
+        self.caption_column = require_non_empty_string(caption_column, "caption_column")
+        self.shot_groups_column = require_non_empty_string(shot_groups_column, "shot_groups_column")
+        self.case_id_column = (
+            require_non_empty_string(case_id_column, "case_id_column")
+            if case_id_column is not None
+            else None
+        )
+        self.case_id_prefix = require_non_empty_string(case_id_prefix, "case_id_prefix")
+        self.dataset_use_label = require_non_empty_string(dataset_use_label, "dataset_use_label")
+        self.allowed_use_column = (
+            require_non_empty_string(allowed_use_column, "allowed_use_column")
+            if allowed_use_column is not None
+            else None
+        )
+        if required_allowed_use is not None and self.allowed_use_column is None:
+            raise ValueError("required_allowed_use requires allowed_use_column")
+        self.required_allowed_use = (
+            require_non_empty_string(required_allowed_use, "required_allowed_use")
+            if required_allowed_use is not None
+            else None
+        )
+        self.frame_planner = FpsAwareTargetFpsPlanner(
+            max_rgb_frames=max_rgb_frames,
+            target_fps=target_fps,
+            vae_temporal_stride=vae_temporal_stride,
+        )
+        import torchvision.transforms as transforms
+
+        self.transform_centercrop = transforms.CenterCrop((self.height, self.width))
+        self.metadata_filter = metadata_filter
+        self.metadata_summary: dict[str, Any] = {}
+        self.data = self._load_metadata()
+
+    def _load_metadata(self) -> list[dict[str, Any]]:
+        metadata = pd.read_csv(self.metadata_path)
+        extra_columns = [self.shot_groups_column]
+        if self.case_id_column is not None:
+            extra_columns.append(self.case_id_column)
+        if self.allowed_use_column is not None:
+            extra_columns.append(self.allowed_use_column)
+        summary_extra = {
+            "schema": self.schema,
+            "prompt_format": self.prompt_format,
+            "frame_policy": self.frame_policy,
+            "target_fps": self.frame_planner.target_fps,
+            "max_rgb_frames": self.frame_planner.max_rgb_frames,
+            "vae_temporal_stride": self.frame_planner.vae_temporal_stride,
+            "num_row_preflight_workers": self.metadata_filter["num_row_preflight_workers"],
+        }
+        summary_extra["dataset_use_label"] = self.dataset_use_label
+        summary_extra["allowed_use_column"] = self.allowed_use_column
+        summary_extra["required_allowed_use"] = self.required_allowed_use
+        summary_extra["case_id_column"] = self.case_id_column
+        summary_extra["case_id_prefix"] = self.case_id_prefix
+        filtered, self.metadata_summary = filter_metadata_files(
+            metadata,
+            metadata_path=self.metadata_path,
+            metadata_filter=self.metadata_filter,
+            extra_required_columns=extra_columns,
+            summary_extra=summary_extra,
+        )
+        rows = self._preflight_rows(filtered)
+        self.metadata_summary["preflight_checked_rows"] = len(rows)
+        return rows
+
+    def _preflight_rows(self, filtered: pd.DataFrame) -> list[dict[str, Any]]:
+        seen_case_ids: set[str] = set()
+        source_rows = [filtered.iloc[index].to_dict() for index in range(len(filtered))]
+        num_workers = self.metadata_filter["num_row_preflight_workers"]
+        if num_workers <= 1 or len(source_rows) <= 1:
+            rows = [self._preflight_row(index, row) for index, row in enumerate(source_rows)]
+        else:
+            with ThreadPoolExecutor(max_workers=num_workers) as executor:
+                rows = list(executor.map(lambda item: self._preflight_row(*item), enumerate(source_rows)))
+        for row in rows:
+            case_id = row["_case_id"]
+            if case_id in seen_case_ids:
+                raise ValueError(f"{self.metadata_path}: duplicate case_id={case_id}")
+            seen_case_ids.add(case_id)
+        return rows
+
